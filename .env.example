# Copy file ini jadi .env.local lalu isi dengan nilai asli.
# Jangan pernah commit .env.local yang berisi nilai asli.
#
# File ini ikut ter-commit, jadi isinya WAJIB cuma placeholder.
# Jangan pernah menaruh nilai asli di sini.

# --- Supabase (wajib, bisa diakses browser) ---
# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Admin dashboard (wajib, KHUSUS server) ---
# Secret untuk membuka pintu /admin.
# Jangan pakai prefix NEXT_PUBLIC_ supaya tidak bocor ke browser.
#
# Cara pakai: buka /admin?doorpass=<nilai ini>
# Proxy akan menyetel cookie httpOnly (session cookie) lalu
# mengarahkan ke /admin tanpa query string, supaya secret tidak
# tinggal di history browser maupun header Referer.
# Cookie ini dihapus lagi saat logout, jadi setiap sesi baru wajib
# mengetik doorpass dari awal.
#
# Kalau nilainya salah, kosong, atau env ini tidak ada, /admin
# selalu balas 404 (fail-closed).
ADMIN_DOORPASS=

# Catatan:
# - Tidak perlu SUPABASE_SERVICE_ROLE_KEY. Semua operasi tulis
#   lewat RLS, jadi cukup pakai anon key + session.
# - Policy RLS saat ini (lihat supabase/migrations):
#   projects      - SELECT publik, INSERT/UPDATE/DELETE admin only
#   skills        - SELECT publik
#   pesan_kontak  - INSERT publik (form kontak), SELECT admin only
#   profile       - user hanya boleh baris sendiri; role naik
#                   hanya lewat admin
#   admin_activity- SELECT dan INSERT admin only
# - Signup Supabase sudah dimatikan, jadi satu-satunya akun dibuat
#   manual lewat Dashboard.
# - VERCEL_OIDC_TOKEN di-inject otomatis oleh Vercel, jadi tidak
#   dicantumkan di sini.
